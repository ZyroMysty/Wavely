// Allgemeine Seite: eine lange, scrollbare Liste aus Zeilen verschiedener Art.
// Nur die sichtbaren Zeilen werden gebaut (ListView) – auch bei Playlists mit Tausenden Songs.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { IconButton, PillButton, Slider } from "controls.slint";
import { ListView } from "std-widgets.slint";

export struct TrackRow {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
    cover: image,
    has-cover: bool,
}

export struct Card {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    has-cover: bool,
    // Künstler: rundes Bild
    round: bool,
}

export struct PageRow {
    // "hero" | "heading" | "track" | "cards" | "message" | "buttons" | "text" | "spacer"
    kind: string,
    text: string,
    subtext: string,
    // Kleine Überschrift über dem Titel („Playlist“, „Album“, „Künstler“)
    label: string,
    track: TrackRow,
    // Nummer in der Songliste (ab 1) bzw. Index der Songs der Seite
    number: int,
    cards: [Card],
    cover: image,
    has-cover: bool,
    round: bool,
    // Zahlen für Diagramme (0–1)
    values: [float],
}

// Wiederverwendbare Songzeile
export component TrackLine inherits Rectangle {
    in property <TrackRow> track;
    in property <int> number;
    in property <bool> current;
    in property <bool> show-album: true;
    callback play();
    // Position (im Fenster) für das Menü
    callback menu(length, length);
    height: 56px;
    border-radius: 8px;
    background: touch.has-hover ? Theme.surface-2 : transparent;
    touch := TouchArea {
        double-clicked => {
            root.play();
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;
        Rectangle {
            width: 24px;
            if !touch.has-hover: Text {
                width: parent.width;
                height: parent.height;
                text: root.number;
                color: root.current ? Theme.accent : Theme.text-dim;
                horizontal-alignment: right;
                vertical-alignment: center;
                font-size: 13px;
            }
            if touch.has-hover: Rectangle {
                Icon {
                    x: parent.width - self.width;
                    path: Icons.play;
                    size: 18px;
                    color: Theme.text;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.play();
                    }
                }
            }
        }
        Rectangle {
            width: 40px;
            Rectangle {
                y: (parent.height - 40px) / 2;
                width: 40px;
                height: 40px;
                border-radius: 6px;
                background: Theme.surface-2;
                clip: true;
                if track.has-cover: Image {
                    width: parent.width;
                    height: parent.height;
                    source: track.cover;
                    image-fit: cover;
                }
                if !track.has-cover: Icon {
                    path: Icons.music;
                    size: 18px;
                    color: Theme.text-dim;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 2;
            // Breite nur nach Anteil, nicht nach Textlänge
            preferred-width: 0px;
            min-width: 0px;
            Text {
                text: track.title;
                color: root.current ? Theme.accent : Theme.text;
                overflow: elide;
                font-weight: 500;
            }
            Text {
                text: track.artist;
                color: Theme.text-dim;
                overflow: elide;
                font-size: 13px;
            }
        }
        if root.show-album: Rectangle {
            horizontal-stretch: 1;
            preferred-width: 0px;
            Text {
                x: 0;
                width: parent.width;
                text: track.album;
                color: Theme.text-dim;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: left;
                font-size: 13px;
            }
        }
        Text {
            width: 48px;
            text: track.duration;
            color: Theme.text-dim;
            horizontal-alignment: right;
            vertical-alignment: center;
            font-size: 13px;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            opacity: touch.has-hover || self.has-hover ? 1 : 0;
            icon: "M6 10c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm12 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm-6 0c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z";
            icon-size: 18px;
            clicked => {
                root.menu(self.absolute-position.x, self.absolute-position.y + self.height);
            }
        }
    }
}

// Kachel (Playlist, Album, Künstler)
component CardView inherits Rectangle {
    in property <Card> card;
    callback open();
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.surface-2 : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.open();
        }
    }
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Rectangle {
            height: self.width;
            border-radius: card.round ? self.width / 2 : 8px;
            background: Theme.surface-2;
            clip: true;
            if card.has-cover: Image {
                width: parent.width;
                height: parent.height;
                source: card.cover;
                image-fit: cover;
            }
            if !card.has-cover: Icon {
                path: Icons.music;
                size: 40px;
                color: Theme.text-dim;
            }
        }
        Rectangle { height: 4px; }
        Text {
            text: card.title;
            color: Theme.text;
            font-weight: 600;
            overflow: elide;
            horizontal-alignment: card.round ? center : left;
        }
        Text {
            text: card.subtitle;
            color: Theme.text-dim;
            font-size: 13px;
            overflow: elide;
            horizontal-alignment: card.round ? center : left;
        }
    }
}

// Kachel-Raster mit automatischem Umbruch
component CardGrid inherits Rectangle {
    in property <[Card]> cards;
    callback open(int);
    property <int> columns: max(1, floor((self.width + 0px) / 182px));
    property <length> cell-width: self.width / columns;
    property <length> cell-height: cell-width + 54px;
    height: ceil(cards.length / columns) * cell-height;
    for card[i] in cards: CardView {
        x: mod(i, columns) * cell-width;
        y: floor(i / columns) * cell-height;
        width: cell-width - 4px;
        height: cell-height - 4px;
        card: card;
        open => {
            root.open(i);
        }
    }
}

export global Page {
    in property <[PageRow]> rows;
    in property <bool> can-go-back;
    in property <bool> loading;
    in property <string> error;
    // Index des laufenden Songs unter den Songs der Seite (-1: keiner)
    in property <string> current-id;
    callback back();
    callback play(int);
    callback card(int, int);
    callback action(string);
    callback track-menu(int, length, length);
    // Wavely-Konto: Name, E-Mail, Passwort, "login" | "register"
    callback login(string, string, string, string);
    // Eingabefeld einer Einstellung bestätigt (Kennung, Text)
    callback input(string, string);
    callback reset-password(string);
    // Auswahl-Zeile angeklickt (Zeile, Position fürs Menü)
    callback select(int, length, length);
    // Equalizer
    in property <[float]> eq-gains;
    callback eq-band(int, float);
}

// Eingabefeld (Anmeldung)
component LoginField inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password;
    in-out property <string> text;
    callback accepted();
    height: 40px;
    border-radius: 8px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    if input.text == "": Text {
        x: 12px;
        text: root.placeholder;
        color: Theme.text-dim;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 12px;
        width: parent.width - 24px;
        text <=> root.text;
        color: Theme.text;
        vertical-alignment: center;
        single-line: true;
        input-type: root.password ? InputType.password : InputType.text;
        accepted => { root.accepted(); }
    }
}

export component PageView inherits Rectangle {
    // Kopfzeile der Ansicht (Suche, Anmelden …) kommt von außen
    in property <length> side-padding: 32px;
    // Eingaben im Anmeldeformular (bleiben beim Neuaufbau der Zeilen erhalten)
    property <string> login-name;
    property <string> login-email;
    property <string> login-password;
    property <string> login-mode: "login";

    ListView {
        for row[ri] in Page.rows: Rectangle {
            // Höhe je nach Art der Zeile
            height: row.kind == "hero" ? 248px
                : row.kind == "heading" ? 60px
                : row.kind == "track" ? 56px
                : row.kind == "cards" ? grid.height + 8px
                : row.kind == "buttons" ? 56px
                : row.kind == "spacer" ? 16px
                : row.kind == "text" ? text.preferred-height + 16px
                : row.kind == "setting" || row.kind == "select" ? (row.subtext != "" ? 72px : 58px)
                : row.kind == "eq" ? 196px
                : row.kind == "stats" ? 110px
                : row.kind == "bars" ? 130px
                : row.kind == "login" ? (login-mode == "register" ? 300px : 250px) + (row.subtext != "" ? 30px : 0px)
                : row.kind == "account" ? 162px
                : 40px;

            if row.kind == "hero": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-top: 8px;
                padding-bottom: 20px;
                spacing: 24px;
                Rectangle {
                    width: 200px;
                    height: 200px;
                    border-radius: row.round ? 100px : Theme.radius;
                    background: Theme.surface-2;
                    clip: true;
                    drop-shadow-blur: 30px;
                    drop-shadow-color: #00000070;
                    if row.has-cover: Image {
                        width: parent.width;
                        height: parent.height;
                        source: row.cover;
                        image-fit: cover;
                    }
                    if !row.has-cover: Icon {
                        path: Icons.music;
                        size: 64px;
                        color: Theme.text-dim;
                    }
                }
                VerticalLayout {
                    alignment: end;
                    spacing: 4px;
                    Text {
                        text: row.label;
                        font-size: 12px;
                        font-weight: 600;
                        color: Theme.text-dim;
                        letter-spacing: 0.7px;
                    }
                    Text {
                        text: row.text;
                        font-size: 36px;
                        font-weight: 700;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: row.subtext;
                        color: Theme.text-dim;
                        overflow: elide;
                    }
                }
            }

            if row.kind == "heading": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-top: 24px;
                Text {
                    text: row.text;
                    font-size: row.number == 1 ? 30px : 20px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }


            // Einstellung: Titel + Beschreibung links, Bedienelement rechts
            if row.kind == "setting": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-bottom: 6px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 16px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: row.text;
                                color: Theme.text;
                                font-weight: 600;
                                overflow: elide;
                            }
                            if row.subtext != "": Text {
                                text: row.subtext;
                                color: Theme.text-dim;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                        // Schalter
                        if row.label == "toggle": Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: 44px;
                            height: 24px;
                            border-radius: 12px;
                            background: row.number == 1 ? Theme.accent : Theme.hover;
                            Rectangle {
                                x: row.number == 1 ? parent.width - self.width - 3px : 3px;
                                width: 18px;
                                height: 18px;
                                border-radius: 9px;
                                background: #fff;
                                animate x { duration: 120ms; }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Page.action(row.cards[0].id); }
                            }
                        }
                        // Auswahl als Segmente
                        if row.label == "choice": Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 34px;
                            border-radius: 17px;
                            background: Theme.surface-2;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 2px;
                                for opt[oi] in row.cards: Rectangle {
                                    border-radius: 14px;
                                    background: oi == row.number ? Theme.accent : otouch.has-hover ? Theme.hover : transparent;
                                    min-width: otext.preferred-width + 24px;
                                    otext := Text {
                                        text: opt.title;
                                        color: oi == row.number ? #fff : Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                    otouch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { Page.action(opt.id); }
                                    }
                                }
                            }
                        }
                        // Farbauswahl
                        if row.label == "swatches": HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            for sw[si] in row.cards: Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: Theme.accents[si];
                                border-width: si == row.number ? 3px : 0px;
                                border-color: Theme.text;
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Page.action(sw.id); }
                                }
                            }
                            // Eigene Farbe
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: row.number < 0 ? Theme.accent : Theme.surface-2;
                                border-width: row.number < 0 ? 3px : 0px;
                                border-color: Theme.text;
                                Icon {
                                    path: Icons.plus;
                                    size: 16px;
                                    color: row.number < 0 ? #fff : Theme.text-dim;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { Page.action("color-picker"); }
                                }
                            }
                        }
                        // Eingabefeld mit Knopf
                        if row.label == "input": HorizontalLayout {
                            alignment: end;
                            spacing: 8px;
                            field := LoginField {
                                y: (parent.height - self.height) / 2;
                                width: 220px;
                                placeholder: row.cards[0].title;
                                text: row.cards[0].subtitle;
                                accepted => { Page.input(row.cards[0].id, self.text); }
                            }
                            PillButton {
                                y: (parent.height - self.height) / 2;
                                primary: false;
                                text: row.cards[1].title;
                                clicked => { Page.input(row.cards[0].id, field.text); }
                            }
                        }
                        // Regler mit „Normal“-Knopf (Tempo)
                        if row.label == "slider": HorizontalLayout {
                            alignment: end;
                            spacing: 12px;
                            Slider {
                                y: (parent.height - self.height) / 2;
                                width: 200px;
                                maximum: 1;
                                value: row.values[0];
                                released(v) => { Page.input(row.cards[0].id, "\{v}"); }
                            }
                            PillButton {
                                y: (parent.height - self.height) / 2;
                                primary: false;
                                opacity: row.number == 1 ? 1 : 0.5;
                                text: row.cards[0].title;
                                clicked => { Page.action(row.cards[0].id + "=1"); }
                            }
                        }
                        if row.label == "button": PillButton {
                            y: (parent.height - self.height) / 2;
                            primary: false;
                            text: row.cards[0].title;
                            clicked => { Page.action(row.cards[0].id); }
                        }
                    }
                }
            }


            // Auswahl über ein Menü (z. B. Ausgabegerät, Equalizer-Voreinstellung)
            if row.kind == "select": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-bottom: 6px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        spacing: 16px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: row.text;
                                color: Theme.text;
                                font-weight: 600;
                            }
                            if row.subtext != "": Text {
                                text: row.subtext;
                                color: Theme.text-dim;
                                font-size: 13px;
                                overflow: elide;
                            }
                        }
                        select := Rectangle {
                            y: (parent.height - self.height) / 2;
                            height: 34px;
                            width: min(sel-text.preferred-width + 48px, 320px);
                            border-radius: 8px;
                            background: sel-touch.has-hover ? Theme.hover : Theme.surface-2;
                            sel-text := Text {
                                x: 12px;
                                width: parent.width - 40px;
                                text: row.label;
                                color: Theme.text;
                                vertical-alignment: center;
                                height: parent.height;
                                overflow: elide;
                            }
                            Icon {
                                x: parent.width - 28px;
                                path: Icons.chevron;
                                size: 18px;
                                color: Theme.text-dim;
                            }
                            sel-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Page.select(ri, self.absolute-position.x, self.absolute-position.y + self.height + 4px);
                                }
                            }
                        }
                    }
                }
            }

            // Equalizer: 10 Bänder (−12 bis +12 dB)
            if row.kind == "eq": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-bottom: 6px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 4px;
                        for gain[bi] in Page.eq-gains: VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: (gain > 0 ? "+" : "") + round(gain);
                                color: Theme.text-dim;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                            band := Rectangle {
                                height: 120px;
                                property <float> ratio: (gain + 12) / 24;
                                Rectangle {
                                    x: (parent.width - 4px) / 2;
                                    width: 4px;
                                    border-radius: 2px;
                                    background: Theme.hover;
                                }
                                Rectangle {
                                    x: (parent.width - 4px) / 2;
                                    width: 4px;
                                    y: gain >= 0 ? parent.height * (1 - band.ratio) : parent.height / 2;
                                    height: abs(gain) / 24 * parent.height;
                                    background: Theme.accent;
                                }
                                Rectangle {
                                    x: (parent.width - 14px) / 2;
                                    y: parent.height * (1 - band.ratio) - 7px;
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 7px;
                                    background: Theme.text;
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down) {
                                            Page.eq-band(bi, round((1 - max(0, min(1, self.mouse-y / self.height))) * 24 - 12));
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            Page.eq-band(bi, round((1 - max(0, min(1, self.mouse-y / self.height))) * 24 - 12));
                                        }
                                    }
                                }
                            }
                            Text {
                                text: row.cards.length > bi ? row.cards[bi].title : "";
                                color: Theme.text-dim;
                                font-size: 11px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }


            // Rückblick: Kennzahlen
            if row.kind == "stats": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-top: 4px;
                padding-bottom: 10px;
                spacing: 10px;
                for stat[si] in row.cards: Rectangle {
                    horizontal-stretch: si == 0 ? 1.6 : 1;
                    background: si == 0 ? Theme.accent-soft : Theme.surface;
                    border-radius: Theme.radius;
                    VerticalLayout {
                        padding: 16px;
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: stat.title;
                            font-size: si == 0 ? 34px : 24px;
                            font-weight: 700;
                            color: si == 0 ? Theme.accent : Theme.text;
                        }
                        Text {
                            text: stat.subtitle;
                            color: Theme.text-dim;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // Rückblick: Balken (Uhrzeit, Wochentag)
            if row.kind == "bars": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-bottom: 10px;
                spacing: 3px;
                for value[vi] in row.values: VerticalLayout {
                    spacing: 4px;
                    Rectangle {
                        vertical-stretch: 1;
                        Rectangle {
                            y: parent.height * (1 - max(0.02, value));
                            height: parent.height * max(0.02, value);
                            border-radius: 3px;
                            background: vi == row.number ? Theme.accent : Theme.hover;
                        }
                    }
                    Text {
                        height: 14px;
                        text: row.cards.length > vi ? row.cards[vi].title : "";
                        color: Theme.text-dim;
                        font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }

            // Anmeldung beim Wavely-Konto
            // Wavely-Konto (angemeldet): Bild, Name (änderbar), E-Mail, Abmelden, Abgleich
            if row.kind == "account": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-bottom: 6px;
                property <bool> editing;
                Rectangle {
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        HorizontalLayout {
                            height: 92px;
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 14px;
                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                width: 48px;
                                height: 48px;
                                border-radius: 24px;
                                background: Theme.accent;
                                Text {
                                    text: row.label;
                                    color: #fff;
                                    font-size: 20px;
                                    font-weight: 700;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                if !editing: HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Text {
                                        text: row.text;
                                        color: Theme.text;
                                        font-weight: 700;
                                        font-size: 16px;
                                        vertical-alignment: center;
                                    }
                                    IconButton {
                                        size: 24px;
                                        icon: Icons.edit;
                                        icon-size: 14px;
                                        clicked => { editing = true; }
                                    }
                                }
                                if editing: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    name-field := LoginField {
                                        width: 220px;
                                        placeholder: "Name";
                                        text: row.text;
                                        accepted => { Page.input("accountName", self.text); editing = false; }
                                    }
                                    PillButton {
                                        primary: false;
                                        text: "Speichern";
                                        clicked => { Page.input("accountName", name-field.text); editing = false; }
                                    }
                                }
                                Text {
                                    text: row.subtext;
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                            PillButton {
                                y: (parent.height - self.height) / 2;
                                primary: false;
                                width: 140px;
                                icon: Icons.logout;
                                text: "Abmelden";
                                clicked => { Page.action("account-logout"); }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text { text: "Abgleich"; color: Theme.text; font-weight: 600; }
                                Text { text: row.cards[0].title; color: Theme.text-dim; font-size: 13px; overflow: elide; }
                            }
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: row.number == 1 ? Icons.check : Icons.refresh;
                                size: 20px;
                                color: row.number == 1 ? Theme.accent : Theme.text-dim;
                            }
                        }
                    }
                }
            }

            if row.kind == "login": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-bottom: 6px;
                Rectangle {
                    background: Theme.surface;
                    border-radius: Theme.radius;
                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        Text {
                            text: login-mode == "register" ? "Neues Wavely-Konto" : row.text;
                            color: Theme.text-dim;
                            wrap: word-wrap;
                        }
                        if login-mode == "register": LoginField {
                            placeholder: "Name (optional)";
                            text <=> login-name;
                        }
                        LoginField {
                            placeholder: "E-Mail";
                            text <=> login-email;
                        }
                        LoginField {
                            placeholder: "Passwort";
                            password: true;
                            text <=> login-password;
                            accepted => { Page.login(login-name, login-email, login-password, login-mode); }
                        }
                        if row.subtext != "": Text {
                            text: row.subtext;
                            color: Theme.accent;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            PillButton {
                                text: row.number == 1 ? "Bitte warten…" : login-mode == "register" ? "Konto erstellen" : "Anmelden";
                                clicked => {
                                    if (row.number != 1) {
                                        Page.login(login-name, login-email, login-password, login-mode);
                                    }
                                }
                            }
                            PillButton {
                                primary: false;
                                text: login-mode == "register" ? "Ich habe schon ein Konto" : "Registrieren";
                                clicked => { login-mode = login-mode == "register" ? "login" : "register"; }
                            }
                            if login-mode != "register": PillButton {
                                primary: false;
                                text: "Passwort vergessen";
                                clicked => { Page.reset-password(login-email); }
                            }
                        }
                    }
                }
            }

            if row.kind == "message": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                Text {
                    text: row.text;
                    color: row.number == 1 ? Theme.accent : Theme.text-dim;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            text := Text {
                visible: row.kind == "text";
                x: root.side-padding;
                width: parent.width - 2 * root.side-padding;
                text: row.kind == "text" ? row.text : "";
                color: Theme.text-dim;
                wrap: word-wrap;
            }

            if row.kind == "buttons": HorizontalLayout {
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-top: 4px;
                padding-bottom: 14px;
                spacing: 8px;
                alignment: start;
                // Knöpfe: Kennung = id, Beschriftung = title, Symbol = subtitle
                for button[ai] in row.cards: PillButton {
                    primary: button.round;
                    text: button.title;
                    icon: button.subtitle;
                    clicked => {
                        Page.action(button.id);
                    }
                }
            }

            if row.kind == "track": HorizontalLayout {
                padding-left: root.side-padding - 12px;
                padding-right: root.side-padding - 12px;
                TrackLine {
                    track: row.track;
                    number: row.number + 1;
                    current: row.track.id == Page.current-id;
                    play => {
                        Page.play(ri);
                    }
                    menu(x, y) => {
                        Page.track-menu(ri, x, y);
                    }
                }
            }

            grid := CardGrid {
                visible: row.kind == "cards";
                x: root.side-padding - 12px;
                width: parent.width - 2 * root.side-padding + 24px;
                cards: row.kind == "cards" ? row.cards : [];
                open(ci) => {
                    Page.card(ri, ci);
                }
            }
        }
    }
}
