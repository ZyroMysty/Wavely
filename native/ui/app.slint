// Hauptfenster: Seitenleiste | Inhalt | (Seitenfeld) und unten die Player-Leiste

import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { IconButton, SquareButton, PillButton, Slider, SearchField } from "controls.slint";
import { ListView } from "std-widgets.slint";
import { Page, PageView, PageRow, TrackRow, TrackLine, Card } from "page.slint";

export { Theme, Page, PageRow, TrackRow, Card }

export struct NavItem {
    id: string,
    label: string,
    icon: string,
}

export global Player {
    in property <string> title;
    in property <string> artist;
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> has-track;
    in property <bool> playing;
    in property <bool> loading;
    in property <string> error;
    in property <float> position;
    in property <float> duration;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in-out property <float> volume: 0.6;
    in property <bool> muted;
    in property <bool> shuffle;
    // "off" | "all" | "one"
    in property <string> repeat: "off";
    // Index des laufenden Songs in der Warteschlange
    in property <int> queue-index: -1;
    in property <bool> can-like;
    in property <bool> liked;
    callback toggle-like();

    callback toggle-play();
    callback next();
    callback previous();
    callback seek(float);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
}

export global Nav {
    in-out property <string> view: "home";
    in property <[NavItem]> items: [
        { id: "home", label: "Startseite", icon: Icons.home },
        { id: "local", label: "Lokale Musik", icon: Icons.folder },
        { id: "youtube", label: "YouTube Music", icon: Icons.youtube },
        { id: "spotify", label: "Spotify", icon: Icons.spotify },
        { id: "soundcloud", label: "SoundCloud", icon: Icons.soundcloud },
        { id: "offline", label: "Offline", icon: Icons.download },
        { id: "recap", label: "Rückblick", icon: Icons.insights },
    ];
    in-out property <bool> collapsed;
    in-out property <string> panel;
    // Dienste an/aus (Einstellungen → Dienste)
    in property <bool> youtube-on: true;
    in property <bool> spotify-on: true;
    in property <bool> soundcloud-on: true;
    in property <bool> local-on: true;
    in property <bool> together-on: true;
    public pure function shown(id: string) -> bool {
        return (id != "youtube" || youtube-on) && (id != "spotify" || spotify-on)
            && (id != "soundcloud" || soundcloud-on) && (id != "local" || local-on);
    }
    // Wavely-Playlists in der Seitenleiste (id, Name) und ihre Songanzahl
    in property <[NavItem]> playlists;
    in property <[int]> playlist-counts;
    in property <string> current-playlist;
    callback select(string);
    callback toggle-panel(string);
    in property <bool> sleep-active;
    callback sleep-menu(length, length);
    callback mini-player();
    in property <bool> together-active;
    callback together-menu(length, length);
    // Taste im Fenster: Name, Strg, Umschalt → behandelt?
    callback key(string, bool, bool) -> bool;
    callback open-playlist(string);
    callback new-playlist();
}

// Eingabedialog (Playlist-Name)
export global Dialog {
    in property <bool> open;
    in property <string> title;
    in-out property <string> value;
    in property <string> confirm-text: "OK";
    callback confirm(string);
    callback cancel();
}

export global YouTube {
    in-out property <string> query;
    // "checking" | "loggedOut" | "loggedIn"
    in property <string> status: "checking";
    in property <string> account-name;
    callback search(string);
    callback login();
}

export global Queue {
    in property <[TrackRow]> tracks;
    callback jump(int);
    callback menu(int, length, length);
}

export struct MenuItem {
    id: string,
    label: string,
    icon: string,
    // Trennlinie davor
    separator: bool,
    // Führt zu einem Untermenü
    chevron: bool,
}

// Kontextmenü (über allem, Klick daneben schließt)
export global Menu {
    in property <bool> open;
    in property <length> x;
    in property <length> y;
    in property <[MenuItem]> items;
    callback pick(string);
    callback close();
}


// Seitenfeld rechts: Verlauf (Zeilen) oder Liedtext
export global Side {
    in property <string> title;
    in property <string> message;
    in property <[PageRow]> rows;
    in property <[string]> lyric-lines;
    in property <bool> lyric-synced;
    in property <int> lyric-current: -1;
    in property <string> lyric-source;
    callback play(int);
    callback menu(int, length, length);
    callback lyric-clicked(int);
}


// Feedback-Dialog
export global Feedback {
    in-out property <bool> open;
    in-out property <string> kind: "bug";
    in-out property <string> text;
    in-out property <string> contact;
    in-out property <bool> with-info: true;
    callback send(string, string, string, bool);
}

// Reiter der Einstellungen
export global SettingsTabs {
    in property <[NavItem]> tabs;
    in-out property <string> current: "account";
    callback select(string);
}

// Kurze Meldung unten in der Mitte
export global Toast {
    in property <string> text;
    in property <bool> error;
    in property <bool> visible;
}


component Sidebar inherits Rectangle {
    width: Nav.collapsed ? 64px : 240px;
    background: Theme.surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding-top: 20px;
        padding-bottom: 20px;
        padding-left: Nav.collapsed ? 10px : 12px;
        padding-right: Nav.collapsed ? 10px : 12px;
        spacing: 24px;

        HorizontalLayout {
            padding-left: Nav.collapsed ? 0 : 8px;
            spacing: 10px;
            alignment: Nav.collapsed ? center : stretch;
            if !Nav.collapsed: Text {
                text: "Wavely";
                font-size: 18px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            SquareButton {
                size: 32px;
                icon-size: 18px;
                icon: Nav.collapsed ? Icons.expand : Icons.collapse;
                clicked => {
                    Nav.collapsed = !Nav.collapsed;
                }
            }
        }

        VerticalLayout {
            spacing: 2px;
            for item in Nav.items: Rectangle {
                visible: Nav.shown(item.id);
                height: Nav.shown(item.id) ? 38px : 0px;
                border-radius: 8px;
                property <bool> active: Nav.view == item.id;
                background: active ? Theme.accent-soft : touch.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;
                    alignment: Nav.collapsed ? center : start;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        path: item.icon;
                        size: 18px;
                        color: active ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-dim;
                    }
                    if !Nav.collapsed: Text {
                        text: item.label;
                        vertical-alignment: center;
                        color: active ? Theme.accent : touch.has-hover ? Theme.text : Theme.text-dim;
                    }
                }
                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Nav.select(item.id);
                    }
                }
            }
        }

        if !Nav.collapsed: VerticalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                padding-bottom: 6px;
                Text {
                    text: "PLAYLISTS";
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 0.7px;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                SquareButton {
                    icon: Icons.plus;
                    clicked => { Nav.new-playlist(); }
                }
            }
            if Nav.playlists.length == 0: Text {
                x: 10px;
                text: "Songs aus allen Quellen mischen";
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            Flickable {
                vertical-stretch: 1;
                content-height: plist.preferred-height;
                plist := VerticalLayout {
                    alignment: start;
                    for playlist[i] in Nav.playlists: Rectangle {
                        height: 34px;
                        border-radius: 8px;
                        property <bool> active: Nav.view == "playlist" && Nav.current-playlist == playlist.id;
                        background: active ? Theme.accent-soft : ptouch.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: playlist.label;
                                color: active ? Theme.accent : Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: Nav.playlist-counts[i];
                                color: Theme.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        ptouch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Nav.open-playlist(playlist.id); }
                        }
                    }
                }
            }
        }
        if Nav.collapsed: Rectangle { vertical-stretch: 1; }

        VerticalLayout {
            spacing: 2px;
            for item in [{ id: "feedback", label: "Feedback", icon: Icons.feedback }, { id: "settings", label: "Einstellungen", icon: Icons.settings }]: Rectangle {
                height: 38px;
                border-radius: 8px;
                property <bool> active: Nav.view == item.id;
                background: active ? Theme.accent-soft : touch2.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 12px;
                    alignment: Nav.collapsed ? center : start;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        path: item.icon;
                        size: 18px;
                        color: active ? Theme.accent : touch2.has-hover ? Theme.text : Theme.text-dim;
                    }
                    if !Nav.collapsed: Text {
                        text: item.label;
                        vertical-alignment: center;
                        color: active ? Theme.accent : touch2.has-hover ? Theme.text : Theme.text-dim;
                    }
                }
                touch2 := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        if (item.id == "feedback") {
                            Feedback.open = true;
                        } else {
                            Nav.select(item.id);
                        }
                    }
                }
            }
        }
    }
}

// Kleines Cover mit Platzhalter
component Cover inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <length> size: 40px;
    width: size;
    height: size;
    border-radius: 6px;
    background: Theme.surface-2;
    clip: true;
    if has-image: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
    }
    if !has-image: Icon {
        path: Icons.music;
        size: root.size * 0.45;
        color: Theme.text-dim;
    }
}

component YouTubeView inherits Rectangle {
    VerticalLayout {
        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 20px;
            padding-bottom: 12px;
            spacing: 8px;
            if Page.can-go-back: IconButton {
                y: (parent.height - self.height) / 2;
                size: 38px;
                icon: Icons.previous;
                icon-size: 18px;
                clicked => { Page.back(); }
            }
            SearchField {
                width: 320px;
                text <=> YouTube.query;
                placeholder: Nav.view == "spotify" ? "Auf Spotify suchen" : Nav.view == "soundcloud" ? "Auf SoundCloud suchen" : "Songs, Alben, Playlists suchen";
                accepted(q) => { YouTube.search(q); }
            }
            Rectangle { horizontal-stretch: 1; }
            if Nav.view == "youtube" && YouTube.status == "loggedOut": PillButton {
                text: "Anmelden";
                clicked => { YouTube.login(); }
            }
            if Nav.view == "youtube" && YouTube.status == "loggedIn" && YouTube.account-name != "": Text {
                text: YouTube.account-name;
                color: Theme.text-dim;
                vertical-alignment: center;
            }
        }
        PageView {
            vertical-stretch: 1;
        }
    }
}

component GenericView inherits Rectangle {
    VerticalLayout {
        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 20px;
            height: Page.can-go-back ? 70px : 20px;
            if Page.can-go-back: IconButton {
                y: (parent.height - self.height) / 2;
                size: 38px;
                icon: Icons.previous;
                icon-size: 18px;
                clicked => { Page.back(); }
            }
        }
        PageView {
            vertical-stretch: 1;
        }
    }
}

component QueuePanel inherits Rectangle {
    width: 360px;
    background: Theme.surface;
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Text {
            text: "Warteschlange";
            font-size: 18px;
            font-weight: 700;
            color: Theme.text;
        }
        ListView {
            vertical-stretch: 1;
            for track[i] in Queue.tracks: TrackLine {
                track: track;
                number: i + 1;
                current: i == Player.queue-index;
                show-album: false;
                play => { Queue.jump(i); }
                menu(x, y) => { Queue.menu(i, x, y); }
            }
        }
    }
}


component SidePanel inherits Rectangle {
    width: 360px;
    background: Theme.surface;
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            Text {
                horizontal-stretch: 1;
                text: Side.title;
                font-size: 18px;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            IconButton {
                icon: Icons.close;
                icon-size: 18px;
                clicked => { Nav.toggle-panel(Nav.panel); }
            }
        }
        if Side.message != "": Text {
            text: Side.message;
            color: Theme.text-dim;
            wrap: word-wrap;
        }
        // Verlauf
        if Nav.panel == "history": ListView {
            vertical-stretch: 1;
            for row[i] in Side.rows: Rectangle {
                height: row.kind == "heading" ? 40px : 56px;
                if row.kind == "heading": Text {
                    x: 8px;
                    y: parent.height - self.height - 6px;
                    text: row.text;
                    font-weight: 700;
                    color: Theme.text;
                }
                if row.kind == "track": TrackLine {
                    track: row.track;
                    number: row.number + 1;
                    show-album: false;
                    play => { Side.play(i); }
                    menu(x, y) => { Side.menu(i, x, y); }
                }
            }
        }
        // Liedtext
        if Nav.panel == "lyrics" && Side.lyric-lines.length > 0: lyric-view := Flickable {
            vertical-stretch: 1;
            property <length> line-height: 54px;
            content-height: Side.lyric-lines.length * line-height + self.height;
            // Aktuelle Zeile etwa im oberen Drittel halten
            property <int> current: Side.lyric-current;
            changed current => {
                if (Side.lyric-synced && self.current >= 0) {
                    self.content-y = min(0px, -(self.current * self.line-height) + self.height / 3);
                }
            }
            animate content-y { duration: 300ms; easing: ease-out; }
            for line[li] in Side.lyric-lines: Rectangle {
                y: li * lyric-view.line-height;
                height: lyric-view.line-height;
                width: parent.width;
                Text {
                    x: 6px;
                    width: parent.width - 12px;
                    height: parent.height;
                    text: line;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                    font-size: Side.lyric-synced ? 17px : 15px;
                    font-weight: Side.lyric-synced ? 600 : 400;
                    color: !Side.lyric-synced ? Theme.text
                        : li == Side.lyric-current ? Theme.text
                        : li < Side.lyric-current ? Theme.text-dim.with-alpha(0.6) : Theme.text-dim;
                }
                if Side.lyric-synced: TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Side.lyric-clicked(li); }
                }
            }
        }
        if Nav.panel == "lyrics" && Side.lyric-source != "": Text {
            text: Side.lyric-source;
            color: Theme.text-dim;
            font-size: 12px;
        }
    }
}

component PlayerBar inherits Rectangle {
    height: 88px;
    property <length> center-width: max(260px, min(560px, self.width * 0.34));
    background: Theme.surface;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;

        // Links: Cover und Titel (links und rechts gleich breit → Steuerung genau in der Mitte)
        HorizontalLayout {
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 140px;
            spacing: 14px;
            if Player.has-track: Cover {
                y: (parent.height - self.height) / 2;
                size: 56px;
                source: Player.cover;
                has-image: Player.has-cover;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: Player.title;
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: Player.error != "" ? Player.error : Player.loading ? "Lädt…" : Player.artist;
                    color: Player.error != "" ? Theme.accent : Theme.text-dim;
                    font-size: 13px;
                    overflow: elide;
                }
            }
            if Player.can-like: IconButton {
                y: (parent.height - self.height) / 2;
                icon: Player.liked ? Icons.heart : Icons.heart-outline;
                on: Player.liked;
                clicked => { Player.toggle-like(); }
            }
        }

        // Platz für die Steuerung (liegt genau in der Mitte des Fensters, siehe unten)
        Rectangle { width: root.center-width; }

        // Rechts: Seitenfelder und Lautstärke
        HorizontalLayout {
            horizontal-stretch: 1;
            preferred-width: 0px;
            alignment: end;
            spacing: 4px;
            if Nav.together-on: IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.group;
                on: Nav.together-active;
                clicked => { Nav.together-menu(self.absolute-position.x - 220px, self.absolute-position.y - 160px); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.bedtime;
                on: Nav.sleep-active;
                clicked => { Nav.sleep-menu(self.absolute-position.x - 200px, self.absolute-position.y - 380px); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.mini-player;
                clicked => { Nav.mini-player(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.lyrics;
                on: Nav.panel == "lyrics";
                clicked => { Nav.toggle-panel("lyrics"); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.history;
                on: Nav.panel == "history";
                clicked => { Nav.toggle-panel("history"); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.queue;
                on: Nav.panel == "queue";
                clicked => { Nav.toggle-panel("queue"); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Player.muted || Player.volume == 0 ? Icons.mute : Icons.volume;
                clicked => { Player.toggle-mute(); }
            }
            Slider {
                y: (parent.height - self.height) / 2;
                width: 96px;
                maximum: 1;
                value: Player.muted ? 0 : Player.volume;
                changed(v) => { Player.set-volume(v); }
            }
        }
    }

        // Mitte: Steuerung und Fortschritt
        VerticalLayout {
            x: (root.width - self.width) / 2;
            width: root.center-width;
            height: root.height;
            alignment: center;
            spacing: 6px;
            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.shuffle;
                    icon-size: 18px;
                    on: Player.shuffle;
                    clicked => { Player.toggle-shuffle(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.previous;
                    icon-size: 22px;
                    enabled: Player.has-track;
                    clicked => { Player.previous(); }
                }
                IconButton {
                    icon: Player.playing ? Icons.pause : Icons.play;
                    icon-size: 22px;
                    size: 40px;
                    filled: true;
                    enabled: Player.has-track;
                    clicked => { Player.toggle-play(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.next;
                    icon-size: 22px;
                    enabled: Player.has-track;
                    clicked => { Player.next(); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Player.repeat == "one" ? Icons.repeat-one : Icons.repeat;
                    icon-size: 18px;
                    on: Player.repeat != "off";
                    clicked => { Player.cycle-repeat(); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                property <bool> dragging: seek.dragging;
                Text {
                    width: 40px;
                    text: Player.position-text;
                    color: Theme.text-dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                seek := Slider {
                    maximum: Player.duration;
                    value: Player.position;
                    enabled: Player.has-track;
                    released(v) => { Player.seek(v); }
                }
                Text {
                    width: 40px;
                    text: Player.duration-text;
                    color: Theme.text-dim;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

}

export component AppWindow inherits Window {
    title: "Wavely";
    icon: @image-url("../../src-tauri/icons/128x128.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    // Tastenkürzel (Textfelder bekommen die Tasten selbst)
    keys := FocusScope {
        key-pressed(event) => {
            if (event.modifiers.alt) { return reject; }
            if (Nav.key(
                event.text == Key.LeftArrow ? "left" : event.text == Key.RightArrow ? "right"
                    : event.text == Key.UpArrow ? "up" : event.text == Key.DownArrow ? "down"
                    : event.text == " " ? "space" : event.text,
                event.modifiers.control, event.modifiers.shift)) {
                return accept;
            }
            return reject;
        }
    }
    init => { keys.focus(); }

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;
            Sidebar { }
            Rectangle {
                horizontal-stretch: 1;
                if Nav.view == "youtube" || Nav.view == "soundcloud" || Nav.view == "spotify": YouTubeView { }
                if Nav.view == "settings": HorizontalLayout {
                    Rectangle {
                        width: 220px;
                        VerticalLayout {
                            padding-left: 20px;
                            padding-right: 8px;
                            padding-top: 28px;
                            spacing: 2px;
                            alignment: start;
                            Text {
                                text: "Einstellungen";
                                font-size: 22px;
                                font-weight: 700;
                                color: Theme.text;
                                height: 52px;
                            }
                            for tab in SettingsTabs.tabs: Rectangle {
                                height: 36px;
                                border-radius: 8px;
                                property <bool> active: SettingsTabs.current == tab.id;
                                background: active ? Theme.accent-soft : tab-touch.has-hover ? Theme.hover : transparent;
                                Text {
                                    x: 12px;
                                    height: parent.height;
                                    text: tab.label;
                                    vertical-alignment: center;
                                    color: active ? Theme.accent : tab-touch.has-hover ? Theme.text : Theme.text-dim;
                                }
                                tab-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { SettingsTabs.select(tab.id); }
                                }
                            }
                        }
                    }
                    GenericView { width: parent.width - 220px; }
                }
                if Nav.view != "youtube" && Nav.view != "soundcloud" && Nav.view != "spotify" && Nav.view != "settings": GenericView { }
            }
            if Nav.panel == "queue": QueuePanel { }
            if Nav.panel == "history" || Nav.panel == "lyrics": SidePanel { }
        }
        PlayerBar { }
    }

    // Menü-Ebene
    if Menu.open: Rectangle {
        TouchArea {
            clicked => { Menu.close(); }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                    Menu.close();
                }
            }
        }
        Rectangle {
            property <length> w: 260px;
            x: max(8px, min(Menu.x, root.width - w - 8px));
            y: max(8px, min(Menu.y, root.height - self.height - 8px));
            width: w;
            height: list.preferred-height;
            background: Theme.surface-2;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            list := VerticalLayout {
                padding: 6px;
                for item in Menu.items: VerticalLayout {
                    if item.separator: Rectangle {
                        height: 9px;
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }
                    }
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: item-touch.has-hover ? Theme.hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                path: item.icon;
                                size: 18px;
                                color: Theme.text-dim;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: item.label;
                                color: Theme.text;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if item.chevron: Icon {
                                y: (parent.height - self.height) / 2;
                                path: Icons.chevron;
                                size: 18px;
                                color: Theme.text-dim;
                            }
                        }
                        item-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Menu.pick(item.id); }
                        }
                    }
                }
            }
        }
    }


    // Eingabedialog
    if Dialog.open: Rectangle {
        background: #00000080;
        TouchArea {
            clicked => { Dialog.cancel(); }
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 400px;
            height: dlayout.preferred-height;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            dlayout := VerticalLayout {
                padding: 22px;
                spacing: 16px;
                Text {
                    text: Dialog.title;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.text;
                }
                Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: field.has-focus ? Theme.accent : Theme.border;
                    field := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        text <=> Dialog.value;
                        color: Theme.text;
                        vertical-alignment: center;
                        single-line: true;
                        accepted => { Dialog.confirm(self.text); }
                        init => { self.focus(); self.select-all(); }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton {
                        primary: false;
                        text: "Abbrechen";
                        clicked => { Dialog.cancel(); }
                    }
                    PillButton {
                        text: Dialog.confirm-text;
                        clicked => { Dialog.confirm(Dialog.value); }
                    }
                }
            }
        }
    }


    // Feedback
    if Feedback.open: Rectangle {
        background: #00000080;
        TouchArea { clicked => { Feedback.open = false; } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 480px;
            height: flayout.preferred-height;
            background: Theme.surface;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            TouchArea { }
            flayout := VerticalLayout {
                padding: 22px;
                spacing: 14px;
                Text { text: "Feedback"; font-size: 18px; font-weight: 700; color: Theme.text; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for k in [{ id: "bug", label: "Fehler melden" }, { id: "idea", label: "Idee / Wunsch" }, { id: "other", label: "Sonstiges" }]: PillButton {
                        primary: Feedback.kind == k.id;
                        text: k.label;
                        clicked => { Feedback.kind = k.id; }
                    }
                }
                Rectangle {
                    height: 140px;
                    border-radius: 8px;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: ftext.has-focus ? Theme.accent : Theme.border;
                    if ftext.text == "": Text {
                        x: 12px; y: 10px;
                        text: "Was ist passiert oder was wünschst du dir?";
                        color: Theme.text-dim;
                    }
                    ftext := TextInput {
                        x: 12px; y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text <=> Feedback.text;
                        color: Theme.text;
                        wrap: word-wrap;
                        single-line: false;
                    }
                }
                Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: fcontact.has-focus ? Theme.accent : Theme.border;
                    if fcontact.text == "": Text {
                        x: 12px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: "E-Mail für Rückfragen (optional)";
                        color: Theme.text-dim;
                    }
                    fcontact := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        text <=> Feedback.contact;
                        color: Theme.text;
                        single-line: true;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        y: 0;
                        border-radius: 4px;
                        background: Feedback.with-info ? Theme.accent : Theme.hover;
                        TouchArea { clicked => { Feedback.with-info = !Feedback.with-info; } }
                    }
                    Text {
                        text: "Wavely-Version mitschicken";
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PillButton { primary: false; text: "Abbrechen"; clicked => { Feedback.open = false; } }
                    PillButton { text: "Senden"; clicked => { Feedback.send(Feedback.kind, Feedback.text, Feedback.contact, Feedback.with-info); } }
                }
            }
        }
    }

    // Meldung
    if Toast.visible: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 88px - self.height - 16px;
        width: min(toast-text.preferred-width + 36px, root.width - 40px);
        height: toast-text.preferred-height + 20px;
        border-radius: 10px;
        background: Toast.error ? #b4233c : Theme.surface-2;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000070;
        toast-text := Text {
            x: 18px;
            width: parent.width - 36px;
            text: Toast.text;
            color: Toast.error ? #fff : Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
        }
    }
}
