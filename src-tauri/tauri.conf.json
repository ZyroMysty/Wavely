{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wavely",
  "version": "0.14.0",
  "identifier": "com.wavely.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wavely",
        "width": 1200,
        "height": 780,
        "minWidth": 760,
        "minHeight": 500,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxQUQyQzQyMDk2QkQzRTYKUldUbTAyc0pRaXl0NGZSTGo5YWpKbnJCMTBZNFc3UFhaSFRqdkJsNS9Xd2hhNVFCdGVZRjRSUzkK",
      "endpoints": [
        "https://github.com/ZyroMysty/Wavely/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "wavely"
        ]
      }
    }
  }
}
