{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ytmusic-remote",
  "description": "Erlaubt dem eingebetteten YouTube-Music-Skript, die Discord-Presence zu setzen.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://music.youtube.com/*"]
  },
  "permissions": ["allow-update-presence", "allow-clear-presence"]
}
